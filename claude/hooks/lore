#!/usr/bin/env bash
# lore -- dispatcher for vault writes (#422, parent #420). Contract: SCRIPT_CONTRACT.md.
#
#   lore commit [--vault <dir>] [--project <name>] [--message <msg>] --paths <p>...
#   lore map [--root <dir>] [--name <n>] [--local] [--create-vault]
#   lore version
#
# `map` is first contact: it never prompts. It resolves vault and root, records
# the mapping through lore-map.sh set (which commits through `commit`) and
# creates projects/<name>/. Exit 10 with NEED=vault|name|migrate|jq (plus
# SUGGESTED= for name) when a human must decide; nothing is written then. Exit 2
# when the root is the vault. Stdout: OUTCOME, CHANGED, NAME, TARGET, ROOT.
#
# `commit` is the single committer: the only code that calls squad_vault_commit
# (PR mode, session worktree, union merge stay in squad-common.sh; there is no
# second commit path). It runs synchronously under one vault lock, the
# directory <git-dir>/lore.lock/ holding `owner` (PID=, AT=<epoch>). The lock is
# acquired with mkdir; it is stale when its pid is gone or it is older than
# 10 minutes, and the next caller breaks it with a stderr notice.
# Stdout: OUTCOME=applied|unchanged, CHANGED=yes|no.
# Exit: 0 ok, 2 usage, 20 vault not a git repo / lock wait timed out / commit failed.
# Env: LORE_LOCK_WAIT seconds to wait for a live lock (default 60).
set -u
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=squad-common.sh
. "$HOOK_DIR/squad-common.sh"

LOCK_MAX_AGE=600
LOCK_GRACE=10   # seconds an ownerless lock directory is left alone
MY_OWNER=""
LOCK=""  # global: the EXIT trap runs after cmd_commit returns

lock_owner_field() {  # lock_owner_field <file> <KEY>
  sed -n "s/^$2=//p" "$1" 2>/dev/null | head -n 1
}

# lock_owner_text <lockdir>: the owner file verbatim on one line ("" when absent).
lock_owner_text() {
  tr '\n' ' ' < "$1/owner" 2>/dev/null
}

# lock_mtime <path>: modification time in epoch seconds (BSD or GNU stat).
lock_mtime() {
  stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null
}

# lock_is_stale <lockdir>: 0 when the owner is gone, malformed or too old. A lock
# without an owner file is a holder between mkdir and writing `owner`: stale only
# once the directory itself is older than the grace period.
lock_is_stale() {
  local f="$1/owner" pid at now m
  now="$(date +%s)"
  if [ ! -f "$f" ]; then
    m="$(lock_mtime "$1")"
    case "$m" in ''|*[!0-9]*) return 1 ;; esac
    [ $((now - m)) -gt "$LOCK_GRACE" ] && return 0
    return 1
  fi
  pid="$(lock_owner_field "$f" PID)"; at="$(lock_owner_field "$f" AT)"
  case "$pid" in ''|*[!0-9]*) return 0 ;; esac
  case "$at" in ''|*[!0-9]*) return 0 ;; esac
  kill -0 "$pid" 2>/dev/null || return 0
  [ $((now - at)) -gt "$LOCK_MAX_AGE" ] && return 0
  return 1
}

# lock_acquire <lockdir> <wait-seconds>: 0 held, 1 timed out.
lock_acquire() {
  local lock="$1" wait="$2" waited=0 gone seen
  while :; do
    if mkdir "$lock" 2>/dev/null; then
      # owner appears whole (rename), never as an empty file a waiter could misread.
      printf 'PID=%s\nAT=%s\n' "$$" "$(date +%s)" > "$lock/owner.$$" && mv "$lock/owner.$$" "$lock/owner"
      MY_OWNER="$(lock_owner_text "$lock")"
      return 0
    fi
    if lock_is_stale "$lock"; then
      seen="$(lock_owner_text "$lock")"
      [ -n "${LORE_TEST_BREAK_DELAY:-}" ] && sleep "$LORE_TEST_BREAK_DELAY"
      # rename is atomic: of several breakers only one moves the directory. What
      # it moved must still be the owner it judged stale; else it took a lock
      # acquired in between, which goes back untouched.
      gone="$lock.stale.$$"
      if mv "$lock" "$gone" 2>/dev/null; then
        if [ "$(lock_owner_text "$gone")" = "$seen" ]; then
          echo "lore: broke stale vault lock (${seen:-no owner})" >&2
          rm -rf "$gone"
        else
          [ -e "$lock" ] || mv "$gone" "$lock" 2>/dev/null
          [ -e "$gone" ] && rm -rf "$gone"
        fi
      fi
      continue
    fi
    [ "$waited" -ge "$wait" ] && return 1
    sleep 1; waited=$((waited + 1))
  done
}

# lock_release: remove the lock only while it is still ours.
lock_release() {
  [ -n "$LOCK" ] && [ -n "$MY_OWNER" ] || return 0
  if [ -n "${LORE_TEST_RELEASE_SWAP:-}" ]; then
    printf 'PID=424242\nAT=%s\n' "$(date +%s)" > "$LOCK/owner"
  fi
  [ "$(lock_owner_text "$LOCK")" = "$MY_OWNER" ] && rm -rf "$LOCK"
  return 0
}

cmd_commit() {
  local vault="" proj="" msg="" p gitdir rc=0 pending
  local paths=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --vault)   vault="${2:-}"; shift 2 || break ;;
      --project) proj="${2:-}"; shift 2 || break ;;
      --message) msg="${2:-}"; shift 2 || break ;;
      --paths)   shift; while [ $# -gt 0 ] && [ "${1#--}" = "$1" ]; do paths+=("$1"); shift; done ;;
      *) squad_fail 2 "usage: lore commit [--vault <dir>] [--project <name>] [--message <msg>] --paths <p>..." ;;
    esac
  done
  [ "${#paths[@]}" -gt 0 ] || squad_fail 2 "usage: lore commit [--vault <dir>] [--project <name>] [--message <msg>] --paths <p>..."
  if [ -z "$vault" ]; then
    squad_resolve || exit 20
    vault="$VAULT_PATH"
    [ -n "$proj" ] || proj="${DISPLAY_NAME:-}"
  fi
  [ -n "$proj" ] || proj=vault
  [ -n "$msg" ] || msg="[lore] $(squad_public_name "$vault" "$proj") update $(date '+%Y-%m-%d %H:%M')"
  # The common git dir, so every linked worktree of the vault shares one lock.
  gitdir="$(cd "$vault" 2>/dev/null && cd "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null && pwd -P)" || gitdir=""
  [ -n "$gitdir" ] || squad_fail 20 "$vault is not a git repository"
  LOCK="$gitdir/lore.lock"
  lock_acquire "$LOCK" "${LORE_LOCK_WAIT:-60}" || squad_fail 20 "vault lock busy: $LOCK"
  trap lock_release EXIT
  pending="$(git -C "$vault" status --porcelain -- "${paths[@]}" 2>/dev/null)"
  if [ -z "$pending" ]; then
    squad_emit OUTCOME unchanged; squad_emit CHANGED no
    return 0
  fi
  squad_vault_commit "$vault" "$proj" "$msg" "${paths[@]}" || rc=$?
  [ "$rc" = 10 ] && squad_fail 10 "vault checkout is not on its default branch and the vault is in direct mode; nothing committed (see stderr above)"
  [ "$rc" = 0 ] || squad_fail 20 "vault commit failed; change left uncommitted"
  squad_emit OUTCOME applied; squad_emit CHANGED yes
}

cmd_map() {
  local root="" name="" local_flag="" create=no resolved cand vault pr_root disp ctx f n
  while [ $# -gt 0 ]; do
    case "$1" in
      --root) [ $# -ge 2 ] || squad_fail 2 "--root needs a value"; root="$2"; shift 2 ;;
      --name) [ $# -ge 2 ] || squad_fail 2 "--name needs a value"; name="$2"; shift 2 ;;
      --local) local_flag="--local"; shift ;;
      --create-vault) create=yes; shift ;;
      *) squad_fail 2 "usage: lore map [--root <dir>] [--name <n>] [--local] [--create-vault]" ;;
    esac
  done
  [ -n "$root" ] || root="$PWD"
  [ -d "$root" ] || squad_fail 2 "root is not a directory: $root"
  # shellcheck disable=SC2046
  resolved="$(cd "$root" && bash "$HOOK_DIR/path-resolve.sh" 2>/dev/null)" || squad_fail 20 "path resolution failed"
  vault="$(printf '%s\n' "$resolved" | sed -n 's/^VAULT_PATH=//p')"
  pr_root="$(printf '%s\n' "$resolved" | sed -n 's/^PROJECT_ROOT=//p')"
  disp="$(printf '%s\n' "$resolved" | sed -n 's/^DISPLAY_NAME=//p')"
  [ -n "$vault" ] || squad_fail 20 "no vault path resolved"
  [ -n "$pr_root" ] || pr_root="$(cd "$root" && pwd -P)"
  if [ -d "$vault" ] && [ "$(cd "$vault" && pwd -P)" = "$(cd "$pr_root" && pwd -P)" ]; then
    squad_fail 2 "the vault is not a project: run lore map from a project directory"
  fi
  if ! command -v jq >/dev/null 2>&1; then
    squad_emit NEED jq; squad_fail 10 "jq is required to write the mapping"
  fi
  if [ ! -d "$vault" ]; then
    if [ "$create" != yes ]; then
      squad_emit NEED vault; squad_fail 10 "no vault at $vault; rerun with --create-vault to create it"
    fi
    mkdir -p "$vault" || squad_fail 20 "cannot create $vault"
    git -C "$vault" init -q -b main 2>/dev/null || git -C "$vault" init -q || squad_fail 20 "git init failed in $vault"
    printf '{\n  "projects": {},\n  "state_dir": ".lore"\n}\n' > "$vault/lore-config.json" || squad_fail 20 "cannot write config"
    bash "$HOOK_DIR/lore-map.sh" ignore --vault "$vault" >/dev/null || exit $?
    # A subprocess: cmd_commit holds the lock until this process exits.
    bash "$HOOK_DIR/lore" commit --vault "$vault" --project vault --message "[lore] create vault" --paths lore-config.json .gitignore >/dev/null || exit $?
  fi
  if [ -n "$disp" ] && [ -z "$name" ]; then
    n="$disp"
    squad_emit OUTCOME unchanged; squad_emit CHANGED no; squad_emit NAME "$n"
    if [ "$(jq -r --arg k "$pr_root" '.projects[$k] // empty' "$vault/lore-config.local.json" 2>/dev/null)" = "$n" ]; then
      squad_emit TARGET local
    else
      squad_emit TARGET tracked
    fi
    squad_emit ROOT "$pr_root"
    return 0
  fi
  cand="${name:-$(basename "$pr_root")}"
  ctx=""
  for f in "$vault/lore-config.local.json" "$vault/lore-config.json"; do
    [ -f "$f" ] || continue
    ctx="$(jq -r --arg k "$pr_root" '.context[$k] // empty' "$f" 2>/dev/null)"
    [ -n "$ctx" ] && break
  done
  if [ -d "$pr_root/.squad" ] && [ "$ctx" != repo ]; then
    squad_emit NEED migrate; squad_fail 10 "legacy $pr_root/.squad needs migration: run /lore start"
  fi
  if [ -e "$vault/projects/$cand" ]; then
    n=2
    while [ -e "$vault/projects/$cand-$n" ]; do n=$((n + 1)); done
    squad_emit NEED name; squad_emit SUGGESTED "$cand-$n"
    squad_fail 10 "a vault project named $cand already exists"
  fi
  # lore-map.sh set picks the target, makes a local-only name ignored before the
  # folder exists, and commits a tracked mapping through `commit`; its exit
  # (10 refusal, 20 failure) is surfaced as is, never reported as applied.
  local out rc=0
  out="$(bash "$HOOK_DIR/lore-map.sh" set --vault "$vault" --root "$pr_root" --name "$cand" $local_flag)" || rc=$?
  [ "$rc" = 0 ] || exit "$rc"
  mkdir -p "$vault/projects/$cand" || squad_fail 20 "cannot create projects/$cand"
  squad_emit OUTCOME "$(printf '%s\n' "$out" | sed -n 's/^OUTCOME=//p')"
  squad_emit CHANGED "$(printf '%s\n' "$out" | sed -n 's/^CHANGED=//p')"
  squad_emit NAME "$cand"
  squad_emit TARGET "$(printf '%s\n' "$out" | sed -n 's/^TARGET=//p')"
  squad_emit ROOT "$pr_root"
  squad_emit TRACKED_FILES "$(printf '%s\n' "$out" | sed -n 's/^TRACKED_FILES=//p')"
}

cmd_version() {
  local pj="$HOOK_DIR/../.claude-plugin/plugin.json" v=""
  [ -f "$pj" ] || pj="$HOOK_DIR/../plugin.json"
  [ -f "$pj" ] && v="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$pj" | head -n 1)"
  squad_emit OUTCOME unchanged; squad_emit CHANGED no
  squad_emit VERSION "${v:-unknown}"
}

VERB="${1:-}"; [ $# -gt 0 ] && shift
case "$VERB" in
  commit)  cmd_commit "$@" ;;
  map)     cmd_map "$@" ;;
  version) cmd_version ;;
  *) squad_fail 2 "usage: lore <commit|map|version> ..." ;;
esac
